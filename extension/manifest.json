{
  "manifest_version": 3,
  "name": "CourseCrate",
  "short_name": "CourseCrate",
  "version": "1.0.0",
  "description": "Download a whole Moodle course in one click: files, folders, assignment and forum attachments and links, sorted by section.",
  "author": "Mohammad Saad Ibna Inan",
  "homepage_url": "https://github.com/saadibnainan/CourseCrate",
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "CourseCrate: download this Moodle course",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "storage"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "coursecrate@lecturex.app",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
